// Package pages defines the page templates.
package pages

import "github.com/whalelogic/howtogo/views/layouts"
import "github.com/whalelogic/howtogo/views/components"

templ Constants() {
	@layouts.Base("Constants | How to Go", "/constants", "Declaring and using constants in Go, including typed and untyped constants.") {
		@components.Breadcrumb("constants", "Constants")
		@components.CustomHeader("Constants", "For")
		<p>Constants hold values that do not change. They are great for configuration, sizes, and enumerations. One common use for constants is declaring an <code style="color: red; font-weight: 500;">API_KEY</code>. </p>
		@components.KeyPoints([]string{
			"Constants are declared with <code>const</code> and cannot be changed.",
			"Numeric constants are high-precision until given a type.",
			"You can use constants in expressions; the compiler folds them.",
		})
		<div class="code-block">
			<pre>
				<code class="language-go">
					@templ.Raw(`package main

import "fmt"
import "math"

const s string = "constant"

func main() {

  fmt.Println(s)

  const pi = 3.14
  const n = 500000000
  const d = 3e20 / n
  fmt.Println(math.Sqrt(pi))
  fmt.Println(d)
  fmt.Println(int64(d))
  fmt.Println(math.Sin(n))

}`)
				</code>
			</pre>
		</div>
		<span class="output-label">Output:</span>
		@components.CodeOutput(`constant
1.772004514666935
60000000000
-0.28470407323754404
`)
		<h2>Constants Reference</h2>
		<table class="reference-table">
			<thead>
				<tr>
					<th>Constant</th>
					<th>Type</th>
					<th>Value</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td><code>s</code></td>
					<td><code>string</code></td>
					<td>"constant"</td>
					<td>String constant with explicit type</td>
				</tr>
				<tr>
					<td><code>pi</code></td>
					<td><code>untyped float</code></td>
					<td>3.14</td>
					<td>Mathematical constant for π</td>
				</tr>
				<tr>
					<td><code>n</code></td>
					<td><code>untyped int</code></td>
					<td>500000000</td>
					<td>Large numeric constant</td>
				</tr>
				<tr>
					<td><code>d</code></td>
					<td><code>untyped float</code></td>
					<td>3e20 / n</td>
					<td>Computed constant expression</td>
				</tr>
			</tbody>
		</table>
		<div class="nav-buttons">
			@components.Button("Previous: Variables", "/variables")
			@components.Button("Next: For", "/for")
		</div>
		@components.Footer()
	}
}
