package pages

import "github.com/whalelogic/howtogo/views/layouts"
import "github.com/whalelogic/howtogo/views/components"


templ For() {
	@layouts.Base("For Loops | How to Go") {
		@components.Breadcrumb("for", "For Loops")
		@components.CustomHeader("For Loops")
		<p><code>for</code> is Go's only looping construct. It's versatile and can replace while loops, do-while loops, and traditional for loops from other languages.</p>
		
		<h2>Classic For Loop</h2>
		<p>The most basic form with initialization, condition, and post statement:</p>
		<div class="code-block">
			<pre>
				<code class="language-go">
					@templ.Raw(`package main

import "fmt"

func main() {
    for i := 0; i < 5; i++ {
        fmt.Println(i)
    }
}`)
				</code>
			</pre>
		</div>
		<span class="output-label">Output:</span>
		@components.CodeOutput(`0
1
2
3
4
`)

		<h2>For as While Loop</h2>
		<p>Omit the init and post statements to create a while-style loop:</p>
		<div class="code-block">
			<pre>
				<code class="language-go">
					@templ.Raw(`package main

import "fmt"

func main() {
    i := 0
    for i < 5 {
        fmt.Println(i)
        i++
    }
}`)
				</code>
			</pre>
		</div>
		<span class="output-label">Output:</span>
		@components.CodeOutput(`0
1
2
3
4
`)

		<h2>Infinite Loop with Break</h2>
		<p>Use <code>break</code> to exit an infinite loop:</p>
		<div class="code-block">
			<pre>
				<code class="language-go">
					@templ.Raw(`package main

import "fmt"

func main() {
    i := 0
    for {
        if i >= 5 {
            break
        }
        fmt.Println(i)
        i++
    }
}`)
				</code>
			</pre>
		</div>
		<span class="output-label">Output:</span>
		@components.CodeOutput(`0
1
2
3
4
`)
		<h2>For Loop Patterns</h2>
		<table class="reference-table">
			<thead>
				<tr>
					<th>Pattern</th>
					<th>Example</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td><code>{ "for init; cond; post { }" }</code></td>
					<td><code>{ "for i := 0; i < 10; i++ { }" }</code></td>
					<td>Classic three-component loop</td>
				</tr>
				<tr>
					<td><code>{ "for condition { }" }</code></td>
					<td><code>{ "for i < 10 { }" }</code></td>
					<td>While-style loop</td>
				</tr>
				<tr>
					<td><code>{ "for { }" }</code></td>
					<td><code>{ "for { }" }</code></td>
					<td>Infinite loop (use with break)</td>
				</tr>
				<tr>
					<td><code>{ "for range collection { }" }</code></td>
					<td><code>{ "for i, v := range slice { }" }</code></td>
					<td>Iterate over arrays, slices, maps</td>
				</tr>
			</tbody>
		</table>

		<h2>Control Statements</h2>
		<table class="reference-table">
			<thead>
				<tr>
					<th>Statement</th>
					<th>Purpose</th>
					<th>Example</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td><code>break</code></td>
					<td>Exit the loop immediately</td>
					<td><code>{ "if i > 5 { break }" }</code></td>
				</tr>
				<tr>
					<td><code>continue</code></td>
					<td>Skip to next iteration</td>
					<td><code>{ "if i%2 == 0 { continue }" }</code></td>
				</tr>
			</tbody>
		</table>

		<h2>Key Points</h2>
		<ul>
			<li><code>for</code> is the only looping construct in Go</li>
			<li>All three components (init, condition, post) are optional</li>
			<li>Use <code>break</code> to exit a loop early</li>
			<li>Use <code>continue</code> to skip to the next iteration</li>
			<li>Variables declared in the init statement are scoped to the loop</li>
		</ul>

		<div class="nav-buttons">
			@components.Button("Previous: Constants", "/constants")
			@components.Button("Next: If/Else", "/ifelse")
		</div>
	}
}

