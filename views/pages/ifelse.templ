package pages

import "github.com/whalelogic/howtogo/views/layouts"
import "github.com/whalelogic/howtogo/views/components"

templ IfElse() {
	@layouts.Base("If/Else | How to Go") {
		@components.Breadcrumb("if-else", "If/Else")
		@components.CustomHeader("If/Else", "Switch")
		<p>Branching with <code>if</code> and <code>else</code> in Go is straightforward. Go doesn't require parentheses around conditions, but braces are always required.</p>
		@components.KeyPoints([]string{
			"Parentheses around conditions are not used in Go",
			"Braces <code>{ }</code> are always required, even for single statements",
			"Variables declared in if statements are scoped to that block",
			"Go has no ternary operator - use if/else instead",
		})
		<h2>Basic If Statement</h2>
		<div class="code-block">
			<pre>
				<code class="language-go">
					@templ.Raw(`package main

import "fmt"

func main() {
    if 7%2 == 0 {
        fmt.Println("7 is even")
    } else {
        fmt.Println("7 is odd")
    }
}`)
				</code>
			</pre>
		</div>
		<span class="output-label">Output:</span>
		@components.CodeOutput(`7 is odd`)
		<h2>If Without Else</h2>
		<div class="code-block">
			<pre>
				<code class="language-go">
					@templ.Raw(`package main

import "fmt"

func main() {
    if 8%4 == 0 {
        fmt.Println("8 is divisible by 4")
    }
}`)
				</code>
			</pre>
		</div>
		<span class="output-label">Output:</span>
		@components.CodeOutput(`8 is divisible by 4`)
		<h2>If with Statement</h2>
		<p>You can declare variables scoped to the if statement:</p>
		<div class="code-block">
			<pre>
				<code class="language-go">
					@templ.Raw(`package main

import "fmt"

func main() {
    if num := 9; num < 0 {
        fmt.Println(num, "is negative")
    } else if num < 10 {
        fmt.Println(num, "has 1 digit")
    } else {
        fmt.Println(num, "has multiple digits")
    }
}`)
				</code>
			</pre>
		</div>
		<span class="output-label">Output:</span>
		@components.CodeOutput(`9 has 1 digit`)
		<h2>If/Else Reference</h2>
		<table class="reference-table">
			<thead>
				<tr>
					<th>Pattern</th>
					<th>Example</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td><code>{ "if condition{ }" }</code></td>
					<td><code>{ "if x > 0 { }" }</code></td>
					<td>Basic if statement</td>
				</tr>
				<tr>
					<td><code>{ "if condition { } else { }" }</code></td>
					<td><code>{ "if x > 0 { } else { }" }</code></td>
					<td>If-else statement</td>
				</tr>
				<tr>
					<td><code>{ "if c1 { } else if c2 { }" }</code></td>
					<td><code>{ "if x < 0 { } else if x > 0 { }" }</code></td>
					<td>If-else if chain</td>
				</tr>
				<tr>
					<td><code>{ "if stmt; condition { }" }</code></td>
					<td><code>{ "if n := f(); n > 0 { }" }</code></td>
					<td>If with initialization statement</td>
				</tr>
			</tbody>
		</table>
		<div class="nav-buttons">
			@components.Button("Previous: Constants", "/constants")
			@components.Button("Next: Switch", "/switch")
		</div>
		@components.Footer()
	}
}
