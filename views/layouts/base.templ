// Package layouts defines the layout templates.
package layouts

templ Base(title string, path string, description string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<!-- SEO Meta Tags -->
			<meta name="description" content={ description }/>
			<meta name="author" content="WhaleLogic"/>
			if path == "/analytics" {
				<meta name="robots" content="noindex, follow"/>
			} else {
				<meta name="robots" content="index, follow"/>
			}
			<link rel="canonical" href={ "https://howtogo.dev" + path }/>
			<!-- Open Graph / Facebook -->
			<meta property="og:type" content="article"/>
			<meta property="og:url" content={ "https://howtogo.dev" + path }/>
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:image" content="https://howtogo.dev/img/og/default.jpg" />
			<!-- Twitter -->
			<meta property="twitter:card" content="summary_large_image"/>
			<meta property="twitter:url" content={ "https://howtogo.dev" + path }/>
			<meta property="twitter:title" content={ title }/>
			<meta property="twitter:description" content={ description }/>
			<meta property="twitter:image" content="https://howtogo.dev/img/og/default.jpg"/>
			<!-- Favicon -->
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&family=Google+Sans+Mono:wght@400;500&display=swap"/>
			<link rel="stylesheet" href="/css/style.css"/>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/base16/google-light.min.css"/>
			<script src="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/highlight.min.js"></script>
			<script>hljs.highlightAll();</script>
			<script src="/js/clipboard.js"></script>
			<script src="/js/back-to-top.js"></script>
			<!-- JSON-LD Structured Data -->
			<script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "TechArticle",
              "name": "How to Go",
              "url": "https://howtogo.dev",
              "description": "Learn Go programming with hands-on examples",
              "author": {
                "@type": "Organization",
                "name": "WhaleLogic"
              },
              "programmingLanguage": {
                "@type": "ComputerLanguage",
                "name": "Go"
              }
            }
            </script>
		</head>
		<body>
			<div class="container">
				<h2 align="center" class="site-title">
					<a href="/">
						<img src="/icons/devicon-master/icons/go/go-original.svg" alt="Go Gopher" class="gopher-icon"/>
						How to Go
					</a>
				</h2>
				<main>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}
