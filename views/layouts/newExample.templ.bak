package layouts

import (
  "github.com/whalelogic/howtogo/views/components"
)

templ NewExample(title string) {
  @Base(title) {
    <div class="example">
      @components.CustomHeader("New Example Page")
      <p style="width: 80%;">This is a new example page layout.</p>
      <pre>
        <code class="language-go">
          @templ.Raw(`// Your code example here`)
        </code>
      </pre>
      @components.CodeOutput("go run main.go\n")
      @components.CodeOutput("Output: Example Output\n")
      <h2>Key Points</h2>
      <ul>
        <li>Point one about this example.</li>
        <li>Point two about this example.</li>
        <li>Point three about this example.</li>
      </ul>
      <div style="margin-top: 20px; justify-content: space-between; display: flex; width: 80%;">
        @components.Button("Previous:  Previous Page", "/previous-page")
        @components.Button("Next: Next Page", "/next-page")
      </div>

    </div>
  }
}